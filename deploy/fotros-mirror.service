[Unit]
Description=Fotros Docker Mirror
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=fotros
Group=fotros
WorkingDirectory=/opt/fotros-docker-mirror
ExecStart=/usr/bin/node /opt/fotros-docker-mirror/src/main.js serve
Restart=on-failure
RestartSec=5
TimeoutStopSec=180
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/fotros-docker-mirror/data
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
